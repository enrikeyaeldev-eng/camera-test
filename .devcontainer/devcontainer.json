{
  "name": "A56Cam Android",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "hostRequirements": { "cpus": 4 },
  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools"
  },
  "postCreateCommand": "bash .devcontainer/setup-android.sh",
  "customizations": {
    "vscode": {
      "extensions": ["mathiasfrohlich.Kotlin", "vscjava.vscode-gradle"]
    }
  }
}
